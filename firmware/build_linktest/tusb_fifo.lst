 153:tinyusb/src/common/tusb_fifo.c **** // Copy from fifo to fixed address buffer (usually a tx register) with TU_FIFO_FIXED_ADDR_RW32 mode
 154:tinyusb/src/common/tusb_fifo.c **** void tu_hwfifo_write(volatile void *hwfifo, const uint8_t *src, uint16_t len, const tu_hwfifo_acces
 155:tinyusb/src/common/tusb_fifo.c ****   // Write full available 16/32 bit words to dest
 156:tinyusb/src/common/tusb_fifo.c ****   const uint8_t data_stride = (access_mode != NULL) ? access_mode->data_stride : CFG_TUSB_FIFO_HWFI
 157:tinyusb/src/common/tusb_fifo.c ****   while (len >= data_stride) {
 158:tinyusb/src/common/tusb_fifo.c ****     stride_write(hwfifo, src, data_stride);
 159:tinyusb/src/common/tusb_fifo.c ****     src += data_stride;
 160:tinyusb/src/common/tusb_fifo.c ****     len -= data_stride;
 161:tinyusb/src/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, );
 162:tinyusb/src/common/tusb_fifo.c ****   }
 163:tinyusb/src/common/tusb_fifo.c **** 
 164:tinyusb/src/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE > 1
 165:tinyusb/src/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_16BIT_ACCESS
 166:tinyusb/src/common/tusb_fifo.c ****   // 16-bit access is allowed for odd bytes
 167:tinyusb/src/common/tusb_fifo.c ****   if (len >= 2) {
 168:tinyusb/src/common/tusb_fifo.c ****     *((volatile uint16_t *)hwfifo) = tu_unaligned_read16(src);
 169:tinyusb/src/common/tusb_fifo.c ****     src += 2;
 170:tinyusb/src/common/tusb_fifo.c ****     len -= 2;
 171:tinyusb/src/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, , 2);
 172:tinyusb/src/common/tusb_fifo.c ****   }
 173:tinyusb/src/common/tusb_fifo.c ****       #endif
 174:tinyusb/src/common/tusb_fifo.c **** 
 175:tinyusb/src/common/tusb_fifo.c ****       #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_8BIT_ACCESS
 176:tinyusb/src/common/tusb_fifo.c ****   // 8-bit access is allowed for odd bytes
 177:tinyusb/src/common/tusb_fifo.c ****   while (len > 0) {
 178:tinyusb/src/common/tusb_fifo.c ****     *((volatile uint8_t *)hwfifo) = *src++;
 179:tinyusb/src/common/tusb_fifo.c ****     len--;
 180:tinyusb/src/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, , 1);
 181:tinyusb/src/common/tusb_fifo.c ****   }
 182:tinyusb/src/common/tusb_fifo.c ****       #else
 183:tinyusb/src/common/tusb_fifo.c **** 
 184:tinyusb/src/common/tusb_fifo.c ****   // Write odd bytes i.e 1 byte for 16 bit or 1-3 bytes for 32 bit
 185:tinyusb/src/common/tusb_fifo.c ****   if (len > 0) {
 186:tinyusb/src/common/tusb_fifo.c ****     uint32_t tmp = 0u;
 187:tinyusb/src/common/tusb_fifo.c ****     memcpy(&tmp, src, len);
 188:tinyusb/src/common/tusb_fifo.c ****     stride_write(hwfifo, &tmp, data_stride);
 189:tinyusb/src/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT(hwfifo, );
 190:tinyusb/src/common/tusb_fifo.c ****   }
 191:tinyusb/src/common/tusb_fifo.c ****       #endif
 192:tinyusb/src/common/tusb_fifo.c ****     #endif
 193:tinyusb/src/common/tusb_fifo.c **** }
 194:tinyusb/src/common/tusb_fifo.c ****   #endif
