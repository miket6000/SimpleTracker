 390:tinyusb/src/common/tusb_fifo.c ****     // Linear only case
 391:tinyusb/src/common/tusb_fifo.c ****     memcpy(ff_buf, app_buf, n);
 392:tinyusb/src/common/tusb_fifo.c ****   } else {
 393:tinyusb/src/common/tusb_fifo.c ****     // Wrap around case
 394:tinyusb/src/common/tusb_fifo.c ****     memcpy(ff_buf, app_buf, lin_bytes);                                    // linear part
 395:tinyusb/src/common/tusb_fifo.c ****     memcpy(f->buffer, ((const uint8_t *)app_buf) + lin_bytes, wrap_bytes); // wrapped part
 396:tinyusb/src/common/tusb_fifo.c ****   }
