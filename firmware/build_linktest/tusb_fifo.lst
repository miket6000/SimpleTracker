  59:tinyusb/src/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  60:tinyusb/src/common/tusb_fifo.c **** // Setup API
  61:tinyusb/src/common/tusb_fifo.c **** //--------------------------------------------------------------------+
  62:tinyusb/src/common/tusb_fifo.c **** bool tu_fifo_config(tu_fifo_t *f, void *buffer, uint16_t depth, bool overwritable) {
  63:tinyusb/src/common/tusb_fifo.c ****   // Limit index space to 2*depth - this allows for a fast "modulo" calculation
  64:tinyusb/src/common/tusb_fifo.c ****   // but limits the maximum depth to 2^16/2 = 2^15 and buffer overflows are detectable
  65:tinyusb/src/common/tusb_fifo.c ****   // only if overflow happens once (important for unsupervised DMA applications)
  66:tinyusb/src/common/tusb_fifo.c ****   if (depth > 0x8000) {
  67:tinyusb/src/common/tusb_fifo.c ****     return false;
  68:tinyusb/src/common/tusb_fifo.c ****   }
  69:tinyusb/src/common/tusb_fifo.c **** 
  70:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
  71:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
  72:tinyusb/src/common/tusb_fifo.c **** 
  73:tinyusb/src/common/tusb_fifo.c ****   f->buffer       = (uint8_t *)buffer;
  74:tinyusb/src/common/tusb_fifo.c ****   f->depth        = depth;
  75:tinyusb/src/common/tusb_fifo.c ****   f->overwritable = overwritable;
  76:tinyusb/src/common/tusb_fifo.c ****   f->rd_idx       = 0u;
  77:tinyusb/src/common/tusb_fifo.c ****   f->wr_idx       = 0u;
  78:tinyusb/src/common/tusb_fifo.c **** 
  79:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
  80:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
  81:tinyusb/src/common/tusb_fifo.c **** 
  82:tinyusb/src/common/tusb_fifo.c ****   return true;
  83:tinyusb/src/common/tusb_fifo.c **** }
  84:tinyusb/src/common/tusb_fifo.c **** 
  85:tinyusb/src/common/tusb_fifo.c **** // clear fifo by resetting read and write indices
  86:tinyusb/src/common/tusb_fifo.c **** void tu_fifo_clear(tu_fifo_t *f) {
  87:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
  88:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
  89:tinyusb/src/common/tusb_fifo.c **** 
ARM GAS  /tmp/ccDKNztI.s 			page 3


  90:tinyusb/src/common/tusb_fifo.c ****   f->rd_idx = 0;
  91:tinyusb/src/common/tusb_fifo.c ****   f->wr_idx = 0;
  92:tinyusb/src/common/tusb_fifo.c **** 
  93:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
  94:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
  95:tinyusb/src/common/tusb_fifo.c **** }
  96:tinyusb/src/common/tusb_fifo.c **** 
  97:tinyusb/src/common/tusb_fifo.c **** // Change the fifo overwritable mode
  98:tinyusb/src/common/tusb_fifo.c **** void tu_fifo_set_overwritable(tu_fifo_t *f, bool overwritable) {
  99:tinyusb/src/common/tusb_fifo.c ****   if (f->overwritable == overwritable) {
 100:tinyusb/src/common/tusb_fifo.c ****     return;
 101:tinyusb/src/common/tusb_fifo.c ****   }
 102:tinyusb/src/common/tusb_fifo.c **** 
 103:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_wr);
 104:tinyusb/src/common/tusb_fifo.c ****   ff_lock(f->mutex_rd);
 105:tinyusb/src/common/tusb_fifo.c **** 
 106:tinyusb/src/common/tusb_fifo.c ****   f->overwritable = overwritable;
 107:tinyusb/src/common/tusb_fifo.c **** 
 108:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_wr);
 109:tinyusb/src/common/tusb_fifo.c ****   ff_unlock(f->mutex_rd);
 110:tinyusb/src/common/tusb_fifo.c **** }
