 239:tinyusb/src/common/tusb_fifo.c ****     dest += 2;
 240:tinyusb/src/common/tusb_fifo.c ****     len -= 2;
 241:tinyusb/src/common/tusb_fifo.c ****     HWFIFO_ADDR_NEXT_N(hwfifo, const, 2);
 242:tinyusb/src/common/tusb_fifo.c ****   }
 243:tinyusb/src/common/tusb_fifo.c ****     #endif
 244:tinyusb/src/common/tusb_fifo.c **** 
 245:tinyusb/src/common/tusb_fifo.c ****     #ifdef CFG_TUSB_FIFO_HWFIFO_DATA_ODD_8BIT_ACCESS
 246:tinyusb/src/common/tusb_fifo.c ****   // 8-bit access is allowed for odd bytes
 247:tinyusb/src/common/tusb_fifo.c ****   while (len > 0) {
 248:tinyusb/src/common/tusb_fifo.c ****     *dest++ = *((const volatile uint8_t *)hwfifo);
 249:tinyusb/src/common/tusb_fifo.c ****     len--;
