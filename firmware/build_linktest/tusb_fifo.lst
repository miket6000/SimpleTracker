 113:tinyusb/src/common/tusb_fifo.c **** // Hardware FIFO API
 114:tinyusb/src/common/tusb_fifo.c **** // Support different data access width and address increment scheme
 115:tinyusb/src/common/tusb_fifo.c **** // Can support multiple i.e both 16 and 32-bit data access if needed
 116:tinyusb/src/common/tusb_fifo.c **** //--------------------------------------------------------------------+
 117:tinyusb/src/common/tusb_fifo.c **** #if CFG_TUSB_FIFO_HWFIFO_API
