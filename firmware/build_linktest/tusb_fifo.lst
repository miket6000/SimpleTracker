 119:tinyusb/src/common/tusb_fifo.c ****     #define HWFIFO_ADDR_NEXT_N(_hwfifo, _const, _n) _hwfifo = (_const volatile void *)((uintptr_t)(
 120:tinyusb/src/common/tusb_fifo.c ****   #else
 121:tinyusb/src/common/tusb_fifo.c ****     #define HWFIFO_ADDR_NEXT_N(_hwfifo, _const, _n)
 122:tinyusb/src/common/tusb_fifo.c ****   #endif
 123:tinyusb/src/common/tusb_fifo.c **** 
 124:tinyusb/src/common/tusb_fifo.c ****   #define HWFIFO_ADDR_NEXT(_hwfifo, _const) HWFIFO_ADDR_NEXT_N(_hwfifo, _const, CFG_TUSB_FIFO_HWFIF
 125:tinyusb/src/common/tusb_fifo.c **** 
 126:tinyusb/src/common/tusb_fifo.c **** //------------- Write -------------//
 127:tinyusb/src/common/tusb_fifo.c ****   #ifndef CFG_TUSB_FIFO_HWFIFO_CUSTOM_WRITE
 128:tinyusb/src/common/tusb_fifo.c **** TU_ATTR_ALWAYS_INLINE static inline void stride_write(volatile void *hwfifo, const void *src, uint8
 129:tinyusb/src/common/tusb_fifo.c ****   (void)data_stride; // possible unused
 130:tinyusb/src/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE & 4
 131:tinyusb/src/common/tusb_fifo.c ****       #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE != 4
 132:tinyusb/src/common/tusb_fifo.c ****   if (data_stride == 4)
 133:tinyusb/src/common/tusb_fifo.c ****       #endif
 134:tinyusb/src/common/tusb_fifo.c ****   {
 135:tinyusb/src/common/tusb_fifo.c ****     *((volatile uint32_t *)hwfifo) = tu_unaligned_read32(src);
 136:tinyusb/src/common/tusb_fifo.c ****   }
 137:tinyusb/src/common/tusb_fifo.c ****     #endif
 138:tinyusb/src/common/tusb_fifo.c **** 
