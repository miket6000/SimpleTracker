 148:tinyusb/src/common/tusb_fifo.c ****     #if CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE == 1
 149:tinyusb/src/common/tusb_fifo.c ****   *((volatile uint8_t *)hwfifo) = *(const uint8_t *)src;
