 143:tinyusb/src/common/tusb_fifo.c ****   {
 144:tinyusb/src/common/tusb_fifo.c ****     *((volatile uint16_t *)hwfifo) = tu_unaligned_read16(src);
 145:tinyusb/src/common/tusb_fifo.c ****   }
 146:tinyusb/src/common/tusb_fifo.c ****     #endif
