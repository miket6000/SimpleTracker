 403:tinyusb/src/common/tusb_fifo.c ****   const uint8_t *ff_buf     = f->buffer + rd_ptr;
 404:tinyusb/src/common/tusb_fifo.c **** 
 405:tinyusb/src/common/tusb_fifo.c ****   // single byte access
 406:tinyusb/src/common/tusb_fifo.c ****   if (n <= lin_bytes) {
 407:tinyusb/src/common/tusb_fifo.c ****     // Linear only
 408:tinyusb/src/common/tusb_fifo.c ****     memcpy(app_buf, ff_buf, n);
