 383:tinyusb/src/common/tusb_fifo.c **** // send n items to fifo WITHOUT updating write pointer
 384:tinyusb/src/common/tusb_fifo.c **** static void ff_push_n(const tu_fifo_t *f, const void *app_buf, uint16_t n, uint16_t wr_ptr) {
 385:tinyusb/src/common/tusb_fifo.c ****   uint16_t lin_bytes  = f->depth - wr_ptr;
 386:tinyusb/src/common/tusb_fifo.c ****   uint16_t wrap_bytes = n - lin_bytes;
 387:tinyusb/src/common/tusb_fifo.c ****   uint8_t *ff_buf     = f->buffer + wr_ptr;
 388:tinyusb/src/common/tusb_fifo.c **** 
