  70:tinyusb/src/device/usbd_control.c **** // Queue ZLP status transaction
  71:tinyusb/src/device/usbd_control.c **** static inline bool status_stage_xact(uint8_t rhport, const tusb_control_request_t* request) {
  72:tinyusb/src/device/usbd_control.c ****   // Opposite to endpoint in Data Phase
  73:tinyusb/src/device/usbd_control.c ****   const uint8_t ep_addr = request->bmRequestType_bit.direction ? EDPT_CTRL_OUT : EDPT_CTRL_IN;
  74:tinyusb/src/device/usbd_control.c ****   return usbd_edpt_xfer(rhport, ep_addr, NULL, 0, false);
  75:tinyusb/src/device/usbd_control.c **** }
  76:tinyusb/src/device/usbd_control.c **** 
  77:tinyusb/src/device/usbd_control.c **** // Status phase
  78:tinyusb/src/device/usbd_control.c **** bool tud_control_status(uint8_t rhport, const tusb_control_request_t* request) {
  79:tinyusb/src/device/usbd_control.c ****   _ctrl_xfer.request = (*request);
  80:tinyusb/src/device/usbd_control.c ****   _ctrl_xfer.buffer = NULL;
  81:tinyusb/src/device/usbd_control.c ****   _ctrl_xfer.total_xferred = 0;
  82:tinyusb/src/device/usbd_control.c ****   _ctrl_xfer.data_len = 0;
  83:tinyusb/src/device/usbd_control.c **** 
  84:tinyusb/src/device/usbd_control.c ****   return status_stage_xact(rhport, request);
  85:tinyusb/src/device/usbd_control.c **** }
