 118:Core/Src/linktest.c **** static int8_t lt_nibble(char c) {
 119:Core/Src/linktest.c ****   if (c >= '0' && c <= '9') return c - '0';
 120:Core/Src/linktest.c ****   if (c >= 'a' && c <= 'f') return c - 'a' + 10;
 121:Core/Src/linktest.c ****   if (c >= 'A' && c <= 'F') return c - 'A' + 10;
 122:Core/Src/linktest.c ****   return -1;
 123:Core/Src/linktest.c **** }
