 203:Core/Src/linktest.c **** static void lt_cfg(void *parameter) {
 204:Core/Src/linktest.c ****   char *key = cmd_get_param();
 205:Core/Src/linktest.c ****   char *val = cmd_get_param();
 206:Core/Src/linktest.c ****   if (!key || !val) { print("ERR"); return; }
 207:Core/Src/linktest.c **** 
 208:Core/Src/linktest.c ****   uint32_t v = (uint32_t)strtoul(val, NULL, 0);
 209:Core/Src/linktest.c ****   bool ok = true;
 210:Core/Src/linktest.c ****   switch (key[0]) {
 211:Core/Src/linktest.c ****     case 'f': if (v >= 300000000UL && v <= 700000000UL) lt.freq = v; else ok = false; break;
 212:Core/Src/linktest.c ****     case 's': if (v >= 5 && v <= 12) lt.sf = (uint8_t)v; else ok = false; break;
 213:Core/Src/linktest.c ****     case 'b': if (v <= 10) lt.bw = (uint8_t)v; else ok = false; break;
 214:Core/Src/linktest.c ****     case 'c': if (v >= 1 && v <= 4) lt.cr = (uint8_t)v; else ok = false; break;
 215:Core/Src/linktest.c ****     case 'd': if (v <= 22) lt.power = (uint8_t)v; else ok = false; break;
 216:Core/Src/linktest.c ****     case 'p': if (v >= 6 && v <= 65535) lt.preamble = (uint8_t)v; else ok = false; break;
 217:Core/Src/linktest.c ****     case 'w': {
 218:Core/Src/linktest.c ****       uint8_t sw[2];
 219:Core/Src/linktest.c ****       if (lt_parse_hex(val, sw, 2) == 2) {
 220:Core/Src/linktest.c ****         lt.syncWord[0] = sw[0]; lt.syncWord[1] = sw[1];
 221:Core/Src/linktest.c ****         if (*((uint16_t *)sw) == 0) ok = false;    // reject 0000
 222:Core/Src/linktest.c ****       } else ok = false;
 223:Core/Src/linktest.c ****       break;
 224:Core/Src/linktest.c ****     }
 225:Core/Src/linktest.c ****     case 'i': if (v <= 1) lt.iq = (uint8_t)v; else ok = false; break;
 226:Core/Src/linktest.c ****     case 'l': if (v <= 1) lt.ldro = (uint8_t)v; else ok = false; break;
 227:Core/Src/linktest.c ****     case 't': if (v <= 1) lt.crc = (uint8_t)v; else ok = false; break;
 228:Core/Src/linktest.c ****     default: ok = false;
 229:Core/Src/linktest.c ****   }
 230:Core/Src/linktest.c ****   if (!ok) { print("ERR"); return; }
 231:Core/Src/linktest.c **** 
 232:Core/Src/linktest.c ****   lt_apply_and_restart();
 233:Core/Src/linktest.c ****   print("OK");
 234:Core/Src/linktest.c **** }
