 236:Core/Src/linktest.c **** static void lt_tx_cmd(void *parameter) {
 237:Core/Src/linktest.c ****   char *hex = cmd_get_param();
 238:Core/Src/linktest.c ****   if (!hex) { print("ERR"); return; }
 239:Core/Src/linktest.c ****   uint8_t buf[LORA_MAX_MSG_LEN];
 240:Core/Src/linktest.c ****   int n = lt_parse_hex(hex, buf, sizeof(buf));
 241:Core/Src/linktest.c ****   if (n == 0) { print("ERR"); return; }
 242:Core/Src/linktest.c ****   LoRa_Transmit(lt_lora, buf, (uint8_t)n);
 243:Core/Src/linktest.c ****   lt_stats.txReq++;
 244:Core/Src/linktest.c ****   print("OK");
ARM GAS  /tmp/cczyQwdd.s 			page 9


