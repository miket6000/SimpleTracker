 131:Core/Src/linktest.c **** 
 132:Core/Src/linktest.c **** static void lt_i8(int8_t v) {
 133:Core/Src/linktest.c ****   if (v < 0) { print("-"); lt_u32((uint32_t)(-v)); }
 134:Core/Src/linktest.c ****   else       { lt_u32((uint32_t)v); }
 135:Core/Src/linktest.c **** }
 136:Core/Src/linktest.c **** 
 137:Core/Src/linktest.c **** static void lt_hex16(uint16_t v) {
 138:Core/Src/linktest.c ****   lt_hexbyte((uint8_t)(v >> 8)); lt_hexbyte((uint8_t)(v & 0xFF));
 139:Core/Src/linktest.c **** }
 140:Core/Src/linktest.c **** 
 141:Core/Src/linktest.c **** static int lt_parse_hex(const char *tok, uint8_t *out, int max) {
 142:Core/Src/linktest.c ****   int n = 0;
 143:Core/Src/linktest.c ****   while (*tok && *(tok + 1) && n < max) {
 144:Core/Src/linktest.c ****     int8_t hi = lt_nibble(*tok), lo = lt_nibble(*(tok + 1));
 145:Core/Src/linktest.c ****     if (hi < 0 || lo < 0) return n;
 146:Core/Src/linktest.c ****     out[n++] = (uint8_t)((hi << 4) | lo);
 147:Core/Src/linktest.c ****     tok += 2;
 148:Core/Src/linktest.c ****   }
 149:Core/Src/linktest.c ****   return n;
 150:Core/Src/linktest.c **** }
 151:Core/Src/linktest.c **** 
