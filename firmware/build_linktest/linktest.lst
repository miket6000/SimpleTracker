   1:Core/Src/linktest.c **** // linktest.c — APP_LINKTEST build: comms-band debug firmware.
   2:Core/Src/linktest.c **** //
   3:Core/Src/linktest.c **** // Purpose: debug the LoRa/RF link with a boring, race-free measurement path.
   4:Core/Src/linktest.c **** // Everything that makes v1 hard to debug (GPS/UART2, settings/filesystem,
   5:Core/Src/linktest.c **** // LED sequences, event queue + buffer swap, arbitration/discovery) is
   6:Core/Src/linktest.c **** // excluded from this build. Both bench units flash the same image; roles and
   7:Core/Src/linktest.c **** // radio parameters are assigned at runtime from the USB console, so no
   8:Core/Src/linktest.c **** // reflash is needed per experiment.
   9:Core/Src/linktest.c **** //
  10:Core/Src/linktest.c **** // Commands:
  11:Core/Src/linktest.c **** //   VER            build banner
  12:Core/Src/linktest.c **** //   GET            current radio config
  13:Core/Src/linktest.c **** //   CFG f|s|b|c|d|p|w|i|l|t <val>   freq/SF/BW/CR/power/preamble/sync/IQ/LDRO/CRC
  14:Core/Src/linktest.c **** //                  applies immediately (ApplyConfig + restart RX)
  15:Core/Src/linktest.c **** //   TX <hex>       one raw burst (no UID prefix), single hex token
  16:Core/Src/linktest.c **** //   TXTEST [n] [gap_ms]   stream the 64 B signature pattern (seq in bits 0-1)
  17:Core/Src/linktest.c **** //   RX             one-shot blocking receive, hex + RSSI + SNR
  18:Core/Src/linktest.c **** //   RXS on|off     continuous receive printing (hex + RSSI + SNR per burst)
  19:Core/Src/linktest.c **** //   CAP on|off     capture received pattern bursts into the corruption ring
  20:Core/Src/linktest.c **** //   MAP            corruption map over captured frames (per-position XOR)
  21:Core/Src/linktest.c **** //   CLEAR          reset ring + counters
  22:Core/Src/linktest.c **** //   REG <addr> [n] read n bytes from radio registers
  23:Core/Src/linktest.c **** //   WR <addr> <val>  write one radio register byte
  24:Core/Src/linktest.c **** //   STAT           event counters
  25:Core/Src/linktest.c **** //   RST            radio reset + re-apply config
  26:Core/Src/linktest.c **** //   REBOOT         system reset
  27:Core/Src/linktest.c **** //   REBOOT BL      reset into bench bootloader update mode (noinit SRAM flag)
  28:Core/Src/linktest.c **** //
  29:Core/Src/linktest.c **** // The test pattern is 64 bytes: bytes 0-1 = burst sequence (LE16), bytes
  30:Core/Src/linktest.c **** // 2-63 = known constant (00 FF A5 5A single-bit family ...). CAP stores
  31:Core/Src/linktest.c **** // received bursts; MAP XORs positions 2-63 against the pattern and prints
  32:Core/Src/linktest.c **** // the per-position XOR masks and hit counts.
