 302:Core/Src/linktest.c **** static void lt_map(void *parameter) {
 303:Core/Src/linktest.c ****   if (lt_capCount == 0) { print("MAP n=0"); return; }
 304:Core/Src/linktest.c **** 
 305:Core/Src/linktest.c ****   uint8_t  posXor[LT_PATTERN_LEN] = {0};
 306:Core/Src/linktest.c ****   uint16_t posHit[LT_PATTERN_LEN] = {0};
 307:Core/Src/linktest.c ****   int8_t rssiMin = 127, rssiMax = -128, snrMin = 127, snrMax = -128;
 308:Core/Src/linktest.c ****   uint32_t cleanCount = 0, mismatchCount = 0, corruptCount = 0;
 309:Core/Src/linktest.c ****   uint8_t n = lt_capCount > LT_CAP_MAX ? LT_CAP_MAX : lt_capCount;
 310:Core/Src/linktest.c **** 
 311:Core/Src/linktest.c ****   for (uint8_t i = 0; i < n; i++) {
 312:Core/Src/linktest.c ****     LTCap *c = &lt_caps[i];
 313:Core/Src/linktest.c ****     if (c->rssi < rssiMin) rssiMin = c->rssi;
 314:Core/Src/linktest.c ****     if (c->rssi > rssiMax) rssiMax = c->rssi;
 315:Core/Src/linktest.c ****     if (c->snr < snrMin) snrMin = c->snr;
 316:Core/Src/linktest.c ****     if (c->snr > snrMax) snrMax = c->snr;
 317:Core/Src/linktest.c ****     if (c->len != LT_PATTERN_LEN) { mismatchCount++; continue; }
 318:Core/Src/linktest.c ****     uint8_t burstCorrupt = 0;
 319:Core/Src/linktest.c ****     for (int p = 2; p < LT_PATTERN_LEN; p++) {
 320:Core/Src/linktest.c ****       uint8_t x = (uint8_t)(c->data[p] ^ LT_PATTERN[p]);
 321:Core/Src/linktest.c ****       if (x) { posXor[p] |= x; posHit[p]++; burstCorrupt++; }
 322:Core/Src/linktest.c ****     }
 323:Core/Src/linktest.c ****     if (burstCorrupt == 0) cleanCount++; else corruptCount++;
 324:Core/Src/linktest.c ****   }
 325:Core/Src/linktest.c **** 
 326:Core/Src/linktest.c ****   print("MAP n="); lt_u32(lt_capCount);
 327:Core/Src/linktest.c ****   print(" clean="); lt_u32(cleanCount);
 328:Core/Src/linktest.c ****   print(" corrupt="); lt_u32(corruptCount);
 329:Core/Src/linktest.c ****   print(" mismatch="); lt_u32(mismatchCount);
 330:Core/Src/linktest.c ****   print(" rssi="); lt_i8(rssiMin); print(".."); lt_i8(rssiMax);
 331:Core/Src/linktest.c ****   print(" snr="); lt_i8(snrMin); print(".."); lt_i8(snrMax);
 332:Core/Src/linktest.c ****   print("\n");
 333:Core/Src/linktest.c ****   for (int p = 2; p < LT_PATTERN_LEN; p++) {
 334:Core/Src/linktest.c ****     if (posHit[p] == 0) continue;
 335:Core/Src/linktest.c ****     print("pos "); lt_u32(p);
 336:Core/Src/linktest.c ****     print(" xor=0x"); lt_hexbyte(posXor[p]);
 337:Core/Src/linktest.c ****     print(" hits="); lt_u32(posHit[p]);
 338:Core/Src/linktest.c ****     print("\n");
 339:Core/Src/linktest.c ****   }
 340:Core/Src/linktest.c **** }
