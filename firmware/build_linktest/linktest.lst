 251:Core/Src/linktest.c ****   uint16_t g = gstr ? (uint16_t)atoi(gstr) : 300;
 252:Core/Src/linktest.c ****   if (n == 0) n = 10;
 253:Core/Src/linktest.c ****   lt_tx.active = true;
 254:Core/Src/linktest.c ****   lt_tx.customMode = false;
 255:Core/Src/linktest.c ****   lt_tx.remaining = n;
 256:Core/Src/linktest.c ****   lt_tx.gap = g;
 257:Core/Src/linktest.c ****   lt_tx.nextAt = HAL_GetTick();
 258:Core/Src/linktest.c ****   lt_tx.inFlight = false;
 259:Core/Src/linktest.c ****   print("OK");
 260:Core/Src/linktest.c **** }
