 156:Core/Src/linktest.c **** 
 157:Core/Src/linktest.c **** static void lt_apply_and_restart(void) {
 158:Core/Src/linktest.c ****   LoRa_t *l = lt_lora;
 159:Core/Src/linktest.c ****   l->frequency       = lt.freq;
 160:Core/Src/linktest.c ****   l->spreadingFactor = lt.sf;
 161:Core/Src/linktest.c ****   l->bandwidth       = lt.bw;
 162:Core/Src/linktest.c ****   l->codingRate      = lt.cr;
 163:Core/Src/linktest.c ****   l->preambleLength  = lt.preamble;
 164:Core/Src/linktest.c ****   l->crcEnabled      = lt.crc;
 165:Core/Src/linktest.c ****   l->txPower         = (LoRaTxPower_t)lt.power;
 166:Core/Src/linktest.c ****   l->ldroEnabled     = lt.ldro;
 167:Core/Src/linktest.c **** 
 168:Core/Src/linktest.c ****   LoRa_ApplyConfig(l, lt.freq, lt.sf, lt.bw);
 169:Core/Src/linktest.c ****   LoRa_SetSyncWord(l, lt.syncWord[0], lt.syncWord[1]);
 170:Core/Src/linktest.c ****   if (lt.iq) {
 171:Core/Src/linktest.c ****     // invert IQ at both TX (bit2) and RX (bit0) sides of reg 0x0033
 172:Core/Src/linktest.c ****     uint8_t v = LoRa_ReadRegisterDbg(l, 0x0033);
 173:Core/Src/linktest.c ****     v |= 0x04 | 0x01;
 174:Core/Src/linktest.c ****     LoRa_WriteRegisterDbg(l, 0x0033, v);
 175:Core/Src/linktest.c ****   } else {
 176:Core/Src/linktest.c ****     uint8_t v = LoRa_ReadRegisterDbg(l, 0x0033);
 177:Core/Src/linktest.c ****     v &= (uint8_t)~0x05;
 178:Core/Src/linktest.c ****     LoRa_WriteRegisterDbg(l, 0x0033, v);
 179:Core/Src/linktest.c ****   }
 180:Core/Src/linktest.c ****   LoRa_Receive(l, 5000);
 181:Core/Src/linktest.c **** }
