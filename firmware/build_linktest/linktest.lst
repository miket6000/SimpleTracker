 290:Core/Src/linktest.c ****   if ((v[0] == 'o' && v[1] == 'n') || v[0] == '1') { lt_rxStream = true; print("ON"); }
 291:Core/Src/linktest.c ****   else { lt_rxStream = false; print("OFF"); }
