 262:Core/Src/linktest.c **** static void lt_rx_cmd(void *parameter) {
 263:Core/Src/linktest.c ****   LoRa_t *l = lt_lora;
 264:Core/Src/linktest.c ****   for (uint32_t waited = 0; waited < 5000; waited += 8) {
 265:Core/Src/linktest.c ****     if (l->events & LORA_EVENT_RX_DONE) break;
 266:Core/Src/linktest.c ****     HAL_Delay(8);
 267:Core/Src/linktest.c ****   }
 268:Core/Src/linktest.c ****   if (!(l->events & LORA_EVENT_RX_DONE)) {
 269:Core/Src/linktest.c ****     print("TIMEOUT");
 270:Core/Src/linktest.c ****     l->events = 0;
 271:Core/Src/linktest.c ****     LoRa_Receive(l, 5000);
 272:Core/Src/linktest.c ****     return;
 273:Core/Src/linktest.c ****   }
 274:Core/Src/linktest.c ****   uint8_t len = LoRa_ReadPacket(l, lt_rxFrameBuf, LORA_MAX_MSG_LEN, &lt_info);
 275:Core/Src/linktest.c ****   l->events = 0;
 276:Core/Src/linktest.c ****   LoRa_Receive(l, 5000);
 277:Core/Src/linktest.c **** 
 278:Core/Src/linktest.c ****   lt_stats.rx++;
 279:Core/Src/linktest.c ****   print("RSSI="); lt_i8(lt_info.rssi);
 280:Core/Src/linktest.c ****   print(" SNR="); lt_i8(lt_info.snr);
 281:Core/Src/linktest.c ****   print(" LEN="); lt_u32(len);
 282:Core/Src/linktest.c ****   print(" HEX=");
 283:Core/Src/linktest.c ****   for (int i = 0; i < len; i++) { lt_hexbyte(lt_rxFrameBuf[i]); print(" "); }
 284:Core/Src/linktest.c ****   print("\n");
 285:Core/Src/linktest.c **** }
 286:Core/Src/linktest.c **** 
 287:Core/Src/linktest.c **** static void lt_rxs(void *parameter) {
