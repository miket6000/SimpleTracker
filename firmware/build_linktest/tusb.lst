  45:tinyusb/src/common/tusb_fifo.h **** 
  46:tinyusb/src/common/tusb_fifo.h **** #ifndef CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE
  47:tinyusb/src/common/tusb_fifo.h ****   #define CFG_TUSB_FIFO_HWFIFO_DATA_STRIDE 0
