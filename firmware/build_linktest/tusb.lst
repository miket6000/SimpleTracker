 182:tinyusb/src/tusb.c ****     }
 183:tinyusb/src/tusb.c ****     desc += desc[DESC_OFFSET_LEN];
 184:tinyusb/src/tusb.c ****   }
 185:tinyusb/src/tusb.c ****   return NULL;
 186:tinyusb/src/tusb.c **** }
