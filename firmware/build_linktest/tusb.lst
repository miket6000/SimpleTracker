 244:tinyusb/src/tusb.c **** #if CFG_TUSB_DEBUG
 245:tinyusb/src/tusb.c **** bool tu_edpt_validate(const tusb_desc_endpoint_t *desc_ep, tusb_speed_t speed) {
 246:tinyusb/src/tusb.c ****   const uint16_t max_packet_size = tu_edpt_packet_size(desc_ep);
 247:tinyusb/src/tusb.c ****   TU_LOG2("  Open EP %02X with Size = %u\r\n", desc_ep->bEndpointAddress, max_packet_size);
 248:tinyusb/src/tusb.c **** 
 249:tinyusb/src/tusb.c ****   switch (desc_ep->bmAttributes.xfer) {
 250:tinyusb/src/tusb.c ****     case TUSB_XFER_ISOCHRONOUS: {
 251:tinyusb/src/tusb.c ****       const uint16_t spec_size = (speed == TUSB_SPEED_HIGH ? 1024 : 1023);
 252:tinyusb/src/tusb.c ****       TU_ASSERT(max_packet_size <= spec_size);
 253:tinyusb/src/tusb.c ****       break;
 254:tinyusb/src/tusb.c ****     }
 255:tinyusb/src/tusb.c **** 
 256:tinyusb/src/tusb.c ****     case TUSB_XFER_BULK:
 257:tinyusb/src/tusb.c ****       if (speed == TUSB_SPEED_HIGH) {
 258:tinyusb/src/tusb.c ****         // Bulk highspeed must be EXACTLY 512
 259:tinyusb/src/tusb.c ****         TU_ASSERT(max_packet_size == 512);
 260:tinyusb/src/tusb.c ****       } else {
ARM GAS  /tmp/ccA9SypB.s 			page 6


 261:tinyusb/src/tusb.c ****         // Bulk fullspeed can only be 8, 16, 32, 64
 262:tinyusb/src/tusb.c ****         TU_ASSERT(max_packet_size == 8 || max_packet_size == 16 || max_packet_size == 32 || max_pac
 263:tinyusb/src/tusb.c ****       }
 264:tinyusb/src/tusb.c ****       break;
 265:tinyusb/src/tusb.c **** 
 266:tinyusb/src/tusb.c ****     case TUSB_XFER_INTERRUPT: {
 267:tinyusb/src/tusb.c ****       uint16_t const spec_size = (speed == TUSB_SPEED_HIGH ? 1024 : 64);
 268:tinyusb/src/tusb.c ****       TU_ASSERT(max_packet_size <= spec_size);
 269:tinyusb/src/tusb.c ****       break;
 270:tinyusb/src/tusb.c ****     }
 271:tinyusb/src/tusb.c **** 
 272:tinyusb/src/tusb.c ****     default:
 273:tinyusb/src/tusb.c ****       return false;
 274:tinyusb/src/tusb.c ****   }
 275:tinyusb/src/tusb.c **** 
 276:tinyusb/src/tusb.c ****   return true;
 277:tinyusb/src/tusb.c **** }
 278:tinyusb/src/tusb.c **** #endif
