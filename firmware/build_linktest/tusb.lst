 280:tinyusb/src/tusb.c **** bool tu_bind_driver_to_ep_itf(uint8_t driver_id, uint8_t ep2drv[][2], uint8_t itf2drv[], uint8_t it
 281:tinyusb/src/tusb.c ****                               const uint8_t *p_desc, uint16_t desc_len) {
 282:tinyusb/src/tusb.c ****   const uint8_t *desc_end = p_desc + desc_len;
 283:tinyusb/src/tusb.c ****   while (tu_desc_in_bounds(p_desc, desc_end)) {
 284:tinyusb/src/tusb.c ****     const uint8_t desc_type = tu_desc_type(p_desc);
 285:tinyusb/src/tusb.c **** 
 286:tinyusb/src/tusb.c ****     if (desc_type == TUSB_DESC_ENDPOINT) {
 287:tinyusb/src/tusb.c ****       const uint8_t ep_addr  = ((const tusb_desc_endpoint_t *)p_desc)->bEndpointAddress;
 288:tinyusb/src/tusb.c ****       const uint8_t ep_num   = tu_edpt_number(ep_addr);
 289:tinyusb/src/tusb.c ****       const uint8_t ep_dir   = tu_edpt_dir(ep_addr);
 290:tinyusb/src/tusb.c ****       ep2drv[ep_num][ep_dir] = driver_id;
 291:tinyusb/src/tusb.c ****     } else if (desc_type == TUSB_DESC_INTERFACE) {
