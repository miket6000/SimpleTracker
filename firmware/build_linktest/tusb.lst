 211:tinyusb/src/tusb.c **** 
 212:tinyusb/src/tusb.c **** bool tu_edpt_claim(tu_edpt_state_t* ep_state, osal_mutex_t mutex) {
 213:tinyusb/src/tusb.c ****   (void) mutex;
 214:tinyusb/src/tusb.c **** 
 215:tinyusb/src/tusb.c ****   // pre-check to help reducing mutex lock
 216:tinyusb/src/tusb.c ****   TU_VERIFY(ep_state->busy == 0);
 217:tinyusb/src/tusb.c ****   TU_VERIFY(ep_state->claimed == 0);
 218:tinyusb/src/tusb.c ****   (void) osal_mutex_lock(mutex, OSAL_TIMEOUT_WAIT_FOREVER);
 219:tinyusb/src/tusb.c **** 
 220:tinyusb/src/tusb.c ****   // can only claim the endpoint if it is not busy and not claimed yet.
 221:tinyusb/src/tusb.c ****   bool const available = (ep_state->busy == 0) && (ep_state->claimed == 0);
 222:tinyusb/src/tusb.c ****   if (available) {
 223:tinyusb/src/tusb.c ****     ep_state->claimed = 1;
 224:tinyusb/src/tusb.c ****   }
 225:tinyusb/src/tusb.c **** 
 226:tinyusb/src/tusb.c ****   (void) osal_mutex_unlock(mutex);
 227:tinyusb/src/tusb.c ****   return available;
 228:tinyusb/src/tusb.c **** }
 229:tinyusb/src/tusb.c **** 
 230:tinyusb/src/tusb.c **** bool tu_edpt_release(tu_edpt_state_t* ep_state, osal_mutex_t mutex) {
 231:tinyusb/src/tusb.c ****   (void) mutex;
 232:tinyusb/src/tusb.c ****   (void) osal_mutex_lock(mutex, OSAL_TIMEOUT_WAIT_FOREVER);
 233:tinyusb/src/tusb.c **** 
 234:tinyusb/src/tusb.c ****   // can only release the endpoint if it is claimed and not busy
 235:tinyusb/src/tusb.c ****   bool const ret = (ep_state->claimed == 1) && (ep_state->busy == 0);
 236:tinyusb/src/tusb.c ****   if (ret) {
 237:tinyusb/src/tusb.c ****     ep_state->claimed = 0;
 238:tinyusb/src/tusb.c ****   }
 239:tinyusb/src/tusb.c **** 
 240:tinyusb/src/tusb.c ****   (void) osal_mutex_unlock(mutex);
 241:tinyusb/src/tusb.c ****   return ret;
 242:tinyusb/src/tusb.c **** }
