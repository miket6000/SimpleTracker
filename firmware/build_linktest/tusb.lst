 190:tinyusb/src/tusb.c ****     if (desc[1] == byte1 && desc[2] == byte2) {
 191:tinyusb/src/tusb.c ****       return desc;
 192:tinyusb/src/tusb.c ****     }
 193:tinyusb/src/tusb.c ****     desc += desc[DESC_OFFSET_LEN];
 194:tinyusb/src/tusb.c ****   }
