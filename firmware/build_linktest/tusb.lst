 293:tinyusb/src/tusb.c ****       if (desc_itf->bAlternateSetting == 0) {
 294:tinyusb/src/tusb.c ****         TU_ASSERT(desc_itf->bInterfaceNumber < itf_max);
 295:tinyusb/src/tusb.c ****         itf2drv[desc_itf->bInterfaceNumber] = driver_id;
 296:tinyusb/src/tusb.c ****       }
 297:tinyusb/src/tusb.c ****     }
 298:tinyusb/src/tusb.c **** 
 299:tinyusb/src/tusb.c ****     p_desc = tu_desc_next(p_desc);
 300:tinyusb/src/tusb.c ****   }
 301:tinyusb/src/tusb.c ****   return true;
 302:tinyusb/src/tusb.c **** }
