 148:tinyusb/src/common/tusb_fifo.h ****   {                                                  \
 149:tinyusb/src/common/tusb_fifo.h ****     .buffer       = _buffer,                         \
 150:tinyusb/src/common/tusb_fifo.h ****     .depth        = _depth,                          \
 151:tinyusb/src/common/tusb_fifo.h ****     .overwritable = _overwritable,                   \
 152:tinyusb/src/common/tusb_fifo.h ****   }
 153:tinyusb/src/common/tusb_fifo.h **** 
 154:tinyusb/src/common/tusb_fifo.h **** #define TU_FIFO_DEF(_name, _depth, _overwritable)                    \
 155:tinyusb/src/common/tusb_fifo.h ****   uint8_t   _name##_buf[_depth];                                     \
 156:tinyusb/src/common/tusb_fifo.h ****   tu_fifo_t _name = TU_FIFO_INIT(_name##_buf, _depth, _overwritable)
