 258:tinyusb/src/common/tusb_fifo.h **** // Internal Helper Local
 259:tinyusb/src/common/tusb_fifo.h **** // work on local copies of read/write indices in order to only access them once for re-entrancy
 260:tinyusb/src/common/tusb_fifo.h **** //--------------------------------------------------------------------+
 261:tinyusb/src/common/tusb_fifo.h **** // return overflowable count (index difference), which can be used to determine both fifo count and
 262:tinyusb/src/common/tusb_fifo.h **** TU_ATTR_ALWAYS_INLINE static inline uint16_t tu_ff_overflow_count(uint16_t depth, uint16_t wr_idx, 
 263:tinyusb/src/common/tusb_fifo.h ****   const int32_t diff = (int32_t)wr_idx - (int32_t)rd_idx;
 264:tinyusb/src/common/tusb_fifo.h ****   if (diff >= 0) {
 265:tinyusb/src/common/tusb_fifo.h ****     return (uint16_t)diff;
 266:tinyusb/src/common/tusb_fifo.h ****   } else {
 267:tinyusb/src/common/tusb_fifo.h ****     return (uint16_t)(2 * depth + diff);
 268:tinyusb/src/common/tusb_fifo.h ****   }
 269:tinyusb/src/common/tusb_fifo.h **** }
