  41:tinyusb/src/common/tusb_fifo.h **** // mutex is only needed for RTOS. For OS None, we don't get preempted
  42:tinyusb/src/common/tusb_fifo.h **** #define CFG_FIFO_MUTEX      OSAL_MUTEX_REQUIRED
  43:tinyusb/src/common/tusb_fifo.h **** 
