 137:tinyusb/src/common/tusb_fifo.h ****     uint8_t *ptr; // buffer pointer
 138:tinyusb/src/common/tusb_fifo.h ****   } linear, wrapped;
 139:tinyusb/src/common/tusb_fifo.h **** } tu_fifo_buffer_info_t;
