 146:tinyusb/src/common/tusb_fifo.h **** 
 147:tinyusb/src/common/tusb_fifo.h **** #define TU_FIFO_INIT(_buffer, _depth, _overwritable) \
 148:tinyusb/src/common/tusb_fifo.h ****   {                                                  \
