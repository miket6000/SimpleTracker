 349:tinyusb/src/device/usbd.c **** TU_ATTR_ALWAYS_INLINE static inline usbd_class_driver_t const * get_driver(uint8_t drvid) {
 350:tinyusb/src/device/usbd.c ****   usbd_class_driver_t const *driver = NULL;
 351:tinyusb/src/device/usbd.c ****   if (drvid < _app_driver_count) {
 352:tinyusb/src/device/usbd.c ****     // Application drivers
 353:tinyusb/src/device/usbd.c ****     driver = &_app_driver[drvid];
 354:tinyusb/src/device/usbd.c ****   } else{
 355:tinyusb/src/device/usbd.c ****     drvid -= _app_driver_count;
 356:tinyusb/src/device/usbd.c ****     if (drvid < BUILTIN_DRIVER_COUNT) {
 357:tinyusb/src/device/usbd.c ****       driver = &_usbd_driver[drvid];
 358:tinyusb/src/device/usbd.c ****     }
 359:tinyusb/src/device/usbd.c ****   }
 360:tinyusb/src/device/usbd.c **** 
 361:tinyusb/src/device/usbd.c ****   return driver;
 362:tinyusb/src/device/usbd.c **** }
