 136:tinyusb/src/osal/osal_none.h **** 
 137:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline bool osal_mutex_lock (osal_mutex_t mutex_hdl, uint32_t msec) {
 138:tinyusb/src/osal/osal_none.h ****   return osal_semaphore_wait(mutex_hdl, msec);
 139:tinyusb/src/osal/osal_none.h **** }
 140:tinyusb/src/osal/osal_none.h **** 
 141:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline bool osal_mutex_unlock(osal_mutex_t mutex_hdl) {
