 117:tinyusb/src/osal/osal_none.h **** // MUTEX API
 118:tinyusb/src/osal/osal_none.h **** // Within tinyusb, mutex is never used in ISR context
 119:tinyusb/src/osal/osal_none.h **** //--------------------------------------------------------------------+
