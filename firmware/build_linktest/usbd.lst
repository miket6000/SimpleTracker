  35:tinyusb/src/osal/osal_none.h **** // Spinlock API
  36:tinyusb/src/osal/osal_none.h **** //--------------------------------------------------------------------+
  37:tinyusb/src/osal/osal_none.h **** // Note: This implementation is designed for bare-metal single-core systems without RTOS.
  38:tinyusb/src/osal/osal_none.h **** // - Supports nested locking within the same execution context
  39:tinyusb/src/osal/osal_none.h **** // - NOT suitable for true SMP (Symmetric Multi-Processing) systems
  40:tinyusb/src/osal/osal_none.h **** // - NOT thread-safe for multi-threaded environments
  41:tinyusb/src/osal/osal_none.h **** // - Primarily manages interrupt enable/disable state for critical sections
  42:tinyusb/src/osal/osal_none.h **** typedef struct {
  43:tinyusb/src/osal/osal_none.h ****   void (* interrupt_set)(bool enabled);
ARM GAS  /tmp/cc6y7lvz.s 			page 48


  44:tinyusb/src/osal/osal_none.h ****   uint32_t nested_count;
  45:tinyusb/src/osal/osal_none.h **** } osal_spinlock_t;
  46:tinyusb/src/osal/osal_none.h **** 
  47:tinyusb/src/osal/osal_none.h **** // For SMP, spinlock must be locked by hardware, cannot just use interrupt
  48:tinyusb/src/osal/osal_none.h **** #define OSAL_SPINLOCK_DEF(_name, _int_set) \
  49:tinyusb/src/osal/osal_none.h ****   osal_spinlock_t _name = { .interrupt_set = _int_set, .nested_count = 0 }
  50:tinyusb/src/osal/osal_none.h **** 
  51:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_init(osal_spinlock_t *ctx) {
  52:tinyusb/src/osal/osal_none.h ****   (void) ctx;
  53:tinyusb/src/osal/osal_none.h **** }
  54:tinyusb/src/osal/osal_none.h **** 
  55:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_lock(osal_spinlock_t *ctx, bool in_isr) {
  56:tinyusb/src/osal/osal_none.h ****   // Disable interrupts first to make nested_count increment atomic
  57:tinyusb/src/osal/osal_none.h ****   if (!in_isr && ctx->nested_count == 0) {
  58:tinyusb/src/osal/osal_none.h ****     ctx->interrupt_set(false);
  59:tinyusb/src/osal/osal_none.h ****   }
  60:tinyusb/src/osal/osal_none.h ****   ctx->nested_count++;
  61:tinyusb/src/osal/osal_none.h **** }
  62:tinyusb/src/osal/osal_none.h **** 
  63:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline void osal_spin_unlock(osal_spinlock_t *ctx, bool in_isr) {
  64:tinyusb/src/osal/osal_none.h ****   if (ctx->nested_count == 0) {
  65:tinyusb/src/osal/osal_none.h ****     return; // spin is not locked to begin with
  66:tinyusb/src/osal/osal_none.h ****   }
  67:tinyusb/src/osal/osal_none.h **** 
  68:tinyusb/src/osal/osal_none.h ****   ctx->nested_count--;
  69:tinyusb/src/osal/osal_none.h **** 
  70:tinyusb/src/osal/osal_none.h ****   // Only re-enable interrupts when fully unlocked
  71:tinyusb/src/osal/osal_none.h ****   if (!in_isr && ctx->nested_count == 0) {
  72:tinyusb/src/osal/osal_none.h ****     ctx->interrupt_set(true);
  73:tinyusb/src/osal/osal_none.h ****   }
  74:tinyusb/src/osal/osal_none.h **** }
