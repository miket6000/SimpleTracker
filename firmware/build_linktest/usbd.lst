  53:tinyusb/src/common/tusb_fifo.h **** 
  54:tinyusb/src/common/tusb_fifo.h **** // Due to the use of unmasked pointers, this FIFO does not suffer from losing
  55:tinyusb/src/common/tusb_fifo.h **** // one item slice. Furthermore, write and read operations are completely
  56:tinyusb/src/common/tusb_fifo.h **** // decoupled as write and read functions do not modify a common state. Henceforth,
  57:tinyusb/src/common/tusb_fifo.h **** // writing or reading from the FIFO within an ISR is safe as long as no other
  58:tinyusb/src/common/tusb_fifo.h **** // process (thread or ISR) interferes.
  59:tinyusb/src/common/tusb_fifo.h **** // Also, this FIFO is ready to be used in combination with a DMA as the write and
  60:tinyusb/src/common/tusb_fifo.h **** // read pointers can be updated from within a DMA ISR. Overflows are detectable
  61:tinyusb/src/common/tusb_fifo.h **** // within a certain number (see tu_fifo_overflow()).
  62:tinyusb/src/common/tusb_fifo.h **** 
  63:tinyusb/src/common/tusb_fifo.h **** /* Write/Read "pointer" is in the range of: 0 .. depth - 1, and is used to get the fifo data.
  64:tinyusb/src/common/tusb_fifo.h ****  * Write/Read "index" is always in the range of: 0 .. 2*depth-1
  65:tinyusb/src/common/tusb_fifo.h ****  *
  66:tinyusb/src/common/tusb_fifo.h ****  * The extra window allow us to determine the fifo state of empty or full with only 2 indices
  67:tinyusb/src/common/tusb_fifo.h ****  * Following are examples with depth = 3
  68:tinyusb/src/common/tusb_fifo.h ****  *
  69:tinyusb/src/common/tusb_fifo.h ****  * - empty: W = R
  70:tinyusb/src/common/tusb_fifo.h ****  *                |
  71:tinyusb/src/common/tusb_fifo.h ****  *    -------------------------
  72:tinyusb/src/common/tusb_fifo.h ****  *    | 0 | RW| 2 | 3 | 4 | 5 |
  73:tinyusb/src/common/tusb_fifo.h ****  *
  74:tinyusb/src/common/tusb_fifo.h ****  * - full 1: W > R
  75:tinyusb/src/common/tusb_fifo.h ****  *                |
  76:tinyusb/src/common/tusb_fifo.h ****  *    -------------------------
  77:tinyusb/src/common/tusb_fifo.h ****  *    | 0 | R | 2 | 3 | W | 5 |
  78:tinyusb/src/common/tusb_fifo.h ****  *
  79:tinyusb/src/common/tusb_fifo.h ****  * - full 2: W < R
  80:tinyusb/src/common/tusb_fifo.h ****  *                |
  81:tinyusb/src/common/tusb_fifo.h ****  *    -------------------------
  82:tinyusb/src/common/tusb_fifo.h ****  *    | 0 | 1 | W | 3 | 4 | R |
  83:tinyusb/src/common/tusb_fifo.h ****  *
  84:tinyusb/src/common/tusb_fifo.h ****  * - Number of items in the fifo can be determined in either cases:
  85:tinyusb/src/common/tusb_fifo.h ****  *    - case W >= R: Count = W - R
  86:tinyusb/src/common/tusb_fifo.h ****  *    - case W <  R: Count = 2*depth - (R - W)
  87:tinyusb/src/common/tusb_fifo.h ****  *
  88:tinyusb/src/common/tusb_fifo.h ****  * In non-overwritable mode, computed Count (in above 2 cases) is at most equal to depth.
  89:tinyusb/src/common/tusb_fifo.h ****  * However, in over-writable mode, write index can be repeatedly increased and count can be
ARM GAS  /tmp/cc6y7lvz.s 			page 62


  90:tinyusb/src/common/tusb_fifo.h ****  * temporarily larger than depth (overflowed condition) e.g
  91:tinyusb/src/common/tusb_fifo.h ****  *
  92:tinyusb/src/common/tusb_fifo.h ****  *  - Overflowed 1: write(3), write(1)
  93:tinyusb/src/common/tusb_fifo.h ****  *    In this case we will adjust Read index when read()/peek() is called so that count = depth.
  94:tinyusb/src/common/tusb_fifo.h ****  *                  |
  95:tinyusb/src/common/tusb_fifo.h ****  *      -------------------------
  96:tinyusb/src/common/tusb_fifo.h ****  *      | R | 1 | 2 | 3 | W | 5 |
  97:tinyusb/src/common/tusb_fifo.h ****  *
  98:tinyusb/src/common/tusb_fifo.h ****  *  - Double Overflowed i.e index is out of allowed range [0,2*depth)
  99:tinyusb/src/common/tusb_fifo.h ****  *    This occurs when we continue to write after 1st overflowed to 2nd overflowed. e.g:
 100:tinyusb/src/common/tusb_fifo.h ****  *      write(3), write(1), write(2)
 101:tinyusb/src/common/tusb_fifo.h ****  *    This must be prevented since it will cause unrecoverable state, in above example
 102:tinyusb/src/common/tusb_fifo.h ****  *    if not handled the fifo will be empty instead of continue-to-be full. Since we must not modif
 103:tinyusb/src/common/tusb_fifo.h ****  *    read index in write() function, which cause race condition. We will re-position write index s
 104:tinyusb/src/common/tusb_fifo.h ****  *    after data is written it is a full fifo i.e W = depth - R
 105:tinyusb/src/common/tusb_fifo.h ****  *
 106:tinyusb/src/common/tusb_fifo.h ****  *      re-position W = 1 before write(2)
 107:tinyusb/src/common/tusb_fifo.h ****  *      Note: we should also move data from mem[3] to read index as well, but deliberately skipped 
 108:tinyusb/src/common/tusb_fifo.h ****  *      since it is an expensive operation !!!
 109:tinyusb/src/common/tusb_fifo.h ****  *                  |
 110:tinyusb/src/common/tusb_fifo.h ****  *      -------------------------
 111:tinyusb/src/common/tusb_fifo.h ****  *      | R | W | 2 | 3 | 4 | 5 |
 112:tinyusb/src/common/tusb_fifo.h ****  *
 113:tinyusb/src/common/tusb_fifo.h ****  *      perform write(2), result is still a full fifo.
 114:tinyusb/src/common/tusb_fifo.h ****  *
 115:tinyusb/src/common/tusb_fifo.h ****  *                  |
 116:tinyusb/src/common/tusb_fifo.h ****  *      -------------------------
 117:tinyusb/src/common/tusb_fifo.h ****  *      | R | 1 | 2 | W | 4 | 5 |
 118:tinyusb/src/common/tusb_fifo.h ****  */
 119:tinyusb/src/common/tusb_fifo.h **** typedef struct {
 120:tinyusb/src/common/tusb_fifo.h ****   uint8_t *buffer;              // buffer pointer
 121:tinyusb/src/common/tusb_fifo.h ****   uint16_t depth;               // max items
 122:tinyusb/src/common/tusb_fifo.h ****   bool     overwritable;        // overwritable when full
 123:tinyusb/src/common/tusb_fifo.h ****   // 1 byte padding  here
 124:tinyusb/src/common/tusb_fifo.h **** 
 125:tinyusb/src/common/tusb_fifo.h ****   volatile uint16_t wr_idx;     // write index TODO maybe can drop volatile
 126:tinyusb/src/common/tusb_fifo.h ****   volatile uint16_t rd_idx;     // read index
 127:tinyusb/src/common/tusb_fifo.h **** 
 128:tinyusb/src/common/tusb_fifo.h **** #if OSAL_MUTEX_REQUIRED
 129:tinyusb/src/common/tusb_fifo.h ****   osal_mutex_t mutex_wr;
 130:tinyusb/src/common/tusb_fifo.h ****   osal_mutex_t mutex_rd;
 131:tinyusb/src/common/tusb_fifo.h **** #endif
 132:tinyusb/src/common/tusb_fifo.h **** } tu_fifo_t;
