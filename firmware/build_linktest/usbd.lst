 130:tinyusb/src/osal/osal_none.h **** }
 131:tinyusb/src/osal/osal_none.h **** 
 132:tinyusb/src/osal/osal_none.h **** TU_ATTR_ALWAYS_INLINE static inline bool osal_mutex_delete(osal_mutex_t mutex_hdl) {
 133:tinyusb/src/osal/osal_none.h ****   (void) mutex_hdl;
