 236:Core/Src/main.c ****   /* Architecture description.
 237:Core/Src/main.c ****    * 
 238:Core/Src/main.c ****    * Low level drivers are primarily handled by a task scheduler. This includes polling 
 239:Core/Src/main.c ****    * the LoRa module, flashing LEDs and managing the USB Tx and Rx buffers. These task 
 240:Core/Src/main.c ****    * must happen in a timely manner for the operation of the tracker.
 241:Core/Src/main.c ****    *
 242:Core/Src/main.c ****    * Some task are interrupt driven, most notably the GPS receiver / parser and LoRa 
 243:Core/Src/main.c ****    * event completion.
 244:Core/Src/main.c ****    *
 245:Core/Src/main.c ****    * Higher level logic is taken care of using an event driven framework. For example,
 246:Core/Src/main.c ****    * the GPS rx interrupt will generate an event if it detects a valid GNGGA packet,
 247:Core/Src/main.c ****    * which then potentially creates a lora_tx event. 
 248:Core/Src/main.c ****    *
 249:Core/Src/main.c ****    */
 250:Core/Src/main.c **** 
 251:Core/Src/main.c ****   /* init lora & gps modules */
 252:Core/Src/main.c ****   //HAL_Delay(3000); // short delay to allow user to view init over serial.
 253:Core/Src/main.c ****   lora_init(&hlora);
 254:Core/Src/main.c ****   gps_init(&huart2);
 255:Core/Src/main.c **** #endif // !APP_LINKTEST
 256:Core/Src/main.c **** 
 257:Core/Src/main.c ****   /* create task, arguments are init_delay, period, callback, parameter */
 258:Core/Src/main.c ****   task_build(0, 100, task_led, &appContext);
 259:Core/Src/main.c ****   task_build(0, 100, task_lora, &appContext);
 260:Core/Src/main.c ****   task_build(0, 0, task_usb, &appContext);
 261:Core/Src/main.c ****   task_build(0, 2500, task_measure_voltage, &appContext);
 262:Core/Src/main.c ****   task_build(0, 10, task_gps, &appContext);
 263:Core/Src/main.c ****   task_build(0, 0, lora_process_delayed_response, &appContext);
 264:Core/Src/main.c ****   
 265:Core/Src/main.c ****   // Rx needs to be started once, will restart itself
 266:Core/Src/main.c ****   LoRa_Receive(&hlora, LORA_RX_TIMEOUT_MS);
 267:Core/Src/main.c **** 
 268:Core/Src/main.c ****   /* USER CODE END 2 */
 269:Core/Src/main.c **** 
