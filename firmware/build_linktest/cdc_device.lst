 261:tinyusb/src/common/tusb_fifo.h **** // return overflowable count (index difference), which can be used to determine both fifo count and
 262:tinyusb/src/common/tusb_fifo.h **** TU_ATTR_ALWAYS_INLINE static inline uint16_t tu_ff_overflow_count(uint16_t depth, uint16_t wr_idx, 
 263:tinyusb/src/common/tusb_fifo.h ****   const int32_t diff = (int32_t)wr_idx - (int32_t)rd_idx;
