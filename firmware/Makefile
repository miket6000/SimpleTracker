# link-time optimization gets the CDC-only bootloader within its budget:
# -flto: TU fifo + CDC core cannot shrink further; -nostartfiles drops crt0
# (our own startup asm does data/bss init; SystemInit is a local stub)
ifeq ($(BUILD_BL),1)
CFLAGS += -flto -falign-functions=1 -falign-loops=1 -falign-jumps=1 -falign-labels=1
LDFLAGS += -flto -nostartfiles -Wl,--gc-sections
LIBS =
endif

# optional LTO for app builds (bench build especially; HAL + TU shrink a lot)
ifneq ($(LTO_APP),)
CFLAGS += -flto
LDFLAGS += -flto
endif

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

# comms debug firmware (single tree; GPS/LED/settings/tasks/arbitration cut;
# runtime-configurable radio console). Build output: build_linktest/.
.PHONY: all clean program linktest linktestbl bootloader install_bl program_lt

linktest:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) APP_LINKTEST=1 BUILD_DIR=build_linktest TARGET=firmware_lt all

# bench app for the bootloader slot (points SysTick/VTOR at its own vector
# table at 0x08001800; flashed through tools/flash.py, not dfu-util)
linktestbl:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) APP_LINKTEST=1 LTO_APP=1 BUILD_DIR=build_ltapp TARGET=firmware_ltapp LDSCRIPT=STM32F042G6Ux_FLASH_APP.ld all

# bench bootloader server (standalone, linked at 0x08000000)
bootloader:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) BUILD_BL=1 BUILD_DIR=build_bl TARGET=bootloader LDSCRIPT=bootloader/bl.ld all

install_bl: bootloader
	dfu-util -a 0 -D build_bl/bootloader.bin -s 0x08000000

program_lt: build_linktest/firmware_lt.bin
	dfu-util -a 0 -D build_linktest/firmware_lt.bin -s 0x08000000


#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASMM_SOURCES:.S=.o)))
vpath %.S $(sort $(dir $(ASMM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR) 
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@
$(BUILD_DIR)/%.o: %.S Makefile | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@	
	
$(BUILD_DIR):
	mkdir $@		

#######################################
# clean up
#######################################
clean:
	-rm -fR $(BUILD_DIR)

#######################################
# Support tools
#######################################
program: $(BUILD_DIR)/$(TARGET).bin | $(BUILD_DIR)
	dfu-util -a 0 -D $(BUILD_DIR)/$(TARGET).bin -s 0x08000000


debug_fancy:
	tmux split -h sudo openocd -f interface/jlink.cfg -c 'transport select swd' -f target/stm32f0x.cfg & 
	gdb-multiarch build/firmware.elf -ex 'target extended-remote :3333'

debug:
	openocd -f interface/stlink.cfg -f target/stm32f0x.cfg & echo $$! > openocd.pid
	gdb-multiarch build/firmware.elf -ex 'target extended-remote :3333'
	kill `cat openocd.pid` && rm openocd.pid

serial:
	mkdir -p logs
	python3 -m serial $(PORT) --raw |tee logs/serial_$$(date "+%Y%m%d_%H%M%S")

setup:
	sudo apt install dfu-util \
        build-essential \
        gcc-arm-none-eabi \
        binutils-arm-none-eabi \
        python3-serial \
        openocd \
        gdb-multiarch

